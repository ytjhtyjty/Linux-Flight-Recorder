[Unit]
Description=Linux Flight Recorder boot snapshot (experimental)
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
StateDirectory=lfr
StateDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/local/bin/lfr --system gc
ExecStart=/usr/local/bin/lfr --system snapshot create --source=boot --label=boot
SuccessExitStatus=3
TimeoutStartSec=45s
TimeoutStopSec=5s
KillMode=control-group
Nice=15
IOSchedulingClass=idle
MemoryMax=192M
CPUQuota=25%
TasksMax=32
LimitFSIZE=384M
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
